---
import '../styles/global.css';
import { BOOKING_URL, HOTEL_PAGE_URL } from '../config/booking';

interface Props { title: string; description: string; }
const { title, description } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const canonical = new URL(Astro.url.pathname, Astro.site);
const navigation = [
  { label: 'The hotel', hash: 'hotel', detail: 'A heritage address' },
  { label: 'Rooms & suites', hash: 'rooms', detail: 'Make yourself at home' },
  { label: 'The collection', hash: 'collection', detail: 'A local point of view' },
  { label: 'Monte', hash: 'monte', detail: 'At the table' },
  { label: 'Maitland & beyond', hash: 'maitland', detail: 'Take the long way back' },
];
---
<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#ffffff" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to content</a>
    <header class="site-header">
      <div class="header-inner">
        <button id="menu-btn" class="menu-toggle" aria-label="Explore Monte Pio" aria-expanded="false" aria-controls="menu" aria-haspopup="dialog" hidden>
          <span class="menu-icon" aria-hidden="true"><span></span><span></span></span>
          <span>Explore</span>
        </button>
        <a href={`${base}/`} class="wordmark" aria-label="Monte Pio, Mercure Maitland, home">
          <span>MONTE PIO</span><small>Mercure Maitland</small>
        </a>
        <a href={BOOKING_URL} class="btn header-book" rel="noopener">Book your stay <span aria-hidden="true">↗</span></a>
      </div>
    </header>

    <dialog id="menu" class="menu-dialog" aria-label="Explore Monte Pio">
      <div class="menu-top">
        <a href={`${base}/`} class="wordmark"><span>MONTE PIO</span><small>Mercure Maitland</small></a>
        <button id="menu-close" class="menu-close" aria-label="Close menu">Close <span aria-hidden="true">×</span></button>
      </div>
      <div class="menu-content site-container">
        <nav aria-label="Main">
          <p class="eyebrow menu-eyebrow">A little time at Monte Pio</p>
          <ul class="menu-links">
            {navigation.map((item, index) => (
              <li><a href={`${base}/#${item.hash}`}><span class="menu-number">0{index + 1}</span><span>{item.label}<small>{item.detail}</small></span><span class="menu-arrow" aria-hidden="true">↗</span></a></li>
            ))}
          </ul>
        </nav>
        <div class="menu-aside">
          <p class="eyebrow">We look forward to having you</p>
          <p class="menu-greeting">Stay a while.<br /><em>Feel a world away.</em></p>
          <a class="btn" href={BOOKING_URL} rel="noopener">Book your stay <span aria-hidden="true">↗</span></a>
          <a class="text-link" href={`${base}/book`}>About your booking <span aria-hidden="true">→</span></a>
          <div class="menu-location"><p>Maitland, New South Wales<br />Hunter Valley, Australia</p><a class="text-link" href="#contact">Get in touch <span aria-hidden="true">↗</span></a></div>
        </div>
      </div>
    </dialog>

    <main id="main" tabindex="-1"><slot /></main>

    <footer id="contact" class="site-footer">
      <div class="site-container">
        <div class="footer-top">
          <div><p class="eyebrow">Until we see you</p><p class="footer-greeting">A little closer to <em>getting away.</em></p></div>
          <a class="text-link" href={BOOKING_URL} rel="noopener">Plan your stay <span aria-hidden="true">↗</span></a>
        </div>
        <div class="footer-grid">
          <div class="footer-brand">
            <a href={`${base}/`} class="wordmark"><span>MONTE PIO</span><small>Mercure Maitland</small></a>
            <p>A heritage address.<br />A Hunter Valley state of mind.</p>
            <p class="editor-note">[Official lockup: confirm]</p>
          </div>
          <div><p class="eyebrow">Find us</p><p>[Street address: confirm]<br />Maitland, New South Wales<br />Hunter Valley, Australia</p></div>
          <div><p class="eyebrow">Say hello</p><p>[Phone: confirm]<br />[Email: confirm]</p><p class="editor-note">[Newsletter and socials: confirm]</p></div>
          <nav aria-label="Footer"><p class="eyebrow">A little more</p><a href={`${base}/#rooms`}>Rooms &amp; suites</a><a href={`${base}/#monte`}>Monte</a><a href={`${base}/book`}>Your booking</a><a href={HOTEL_PAGE_URL} rel="noopener">Our Accor page <span aria-hidden="true">↗</span></a></nav>
        </div>
        <div class="footer-bottom"><p>© {new Date().getFullYear()} Mercure Maitland Monte Pio</p><a href={HOTEL_PAGE_URL} rel="noopener">Discover us on ALL Accor <span aria-hidden="true">↗</span></a><a href="#main">Back to top <span aria-hidden="true">↑</span></a></div>
      </div>
    </footer>

    <script>
      const button = document.querySelector<HTMLButtonElement>('#menu-btn')!;
      const menu = document.querySelector<HTMLDialogElement>('#menu')!;
      const closeButton = document.querySelector<HTMLButtonElement>('#menu-close')!;
      button.hidden = false;
      button.addEventListener('click', () => {
        menu.showModal();
        button.setAttribute('aria-expanded', 'true');
        document.body.classList.add('menu-is-open');
        closeButton.focus();
      });
      closeButton.addEventListener('click', () => menu.close());
      menu.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => menu.close()));
      menu.addEventListener('close', () => {
        button.setAttribute('aria-expanded', 'false');
        document.body.classList.remove('menu-is-open');
      });

      if ('IntersectionObserver' in window && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        const observer = new IntersectionObserver((entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              entry.target.classList.add('in');
              observer.unobserve(entry.target);
            }
          }
        }, { rootMargin: '0px 0px -24px 0px' });
        document.querySelectorAll('.reveal').forEach((element) => {
          if (element.getBoundingClientRect().top > window.innerHeight) {
            observer.observe(element);
            element.classList.add('will-reveal');
          }
        });
      }
    </script>
  </body>
</html>
